+    @ac('win', '''
+Respawn the currently active window
+
+Restart the shell in the currently active window without changing its position
+in the layout. The terminal screen will be cleared and a new shell will start.
+You can use :code:`--cwd` to specify the working directory::
+
+    map f5 respawn_window
+    map ctrl+f5 respawn_window --cwd current
+    map shift+f5 respawn_window --cwd /some/path
+''')
+    def respawn_window(self, *args: str) -> None:
+        window = self.window_for_dispatch or self.active_window
+        if not window:
+            return
+
+        cwd_value = None
+        i = 0
+        while i < len(args):
+            arg = args[i]
+            if arg.startswith('--cwd='):
+                cwd_value = arg[6:]
+                break
+            elif arg == '--cwd' and i + 1 < len(args):
+                cwd_value = args[i + 1]
+                break
+            i += 1
+
+        cwd = None
+        if cwd_value == 'current':
+            from kitty.window import CwdRequest
+            cwd = CwdRequest(window).cwd_of_child
+        elif cwd_value == 'last_reported':
+            from kitty.window import CwdRequest, CwdRequestType
+            cwd = CwdRequest(window, CwdRequestType.last_reported).cwd_of_child
+        elif cwd_value in ('oldest', 'root'):
+            from kitty.window import CwdRequest, CwdRequestType
+            cwd_type = CwdRequestType.oldest if cwd_value == 'oldest' else CwdRequestType.root
+            cwd = CwdRequest(window, cwd_type).cwd_of_child
+        elif cwd_value:
+            cwd = cwd_value
+
+        if not window.respawn_child(cwd=cwd):
+            self.show_error(_('Respawn failed'), _('Failed to respawn window'))
+

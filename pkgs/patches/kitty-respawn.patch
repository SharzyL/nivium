diff --git a/kitty/child.py b/kitty/child.py
index ed3da1f37..2ee985a54 100644
--- a/kitty/child.py
+++ b/kitty/child.py
@@ -398,6 +398,47 @@ def fork(self) -> int | None:
                 log_error("Could not move child process into a systemd scope: " + str(err))
         return pid
 
+    def respawn(self, cwd: str | None = None, argv: list[str] | None = None) -> int | None:
+        """Respawn the child process with a new shell.
+
+        Args:
+            cwd: Working directory for the new process. If None, uses os.getcwd()
+                 (same as launch without --cwd).
+            argv: Optional command to run (defaults to original argv)
+
+        Returns:
+            The old pid to kill after updating the monitor, or None if failed.
+            The new process reuses the same fd number via dup2(), so the
+            child monitor continues polling the same fd seamlessly.
+        """
+        if not self.forked:
+            return None
+
+        old_pid = self.pid
+        old_fd = self.child_fd
+        self.forked = False
+
+        # Get a new id like a new Child would, so systemd scope name is unique
+        self.id = next(child_counter)
+
+        # Match launch behavior: use os.getcwd() when cwd not specified
+        self.cwd = os.path.expandvars(os.path.expanduser(cwd or os.getcwd()))
+        if argv is not None:
+            self.argv = argv
+
+        new_pid = self.fork()
+        if new_pid is None:
+            return None
+
+        # Reuse the old fd number: dup2 the new fd onto the old fd
+        # This way the child monitor keeps polling the same fd number
+        if self.child_fd != old_fd:
+            os.dup2(self.child_fd, old_fd)
+            os.close(self.child_fd)
+            self.child_fd = old_fd
+
+        return old_pid
+
     def __del__(self) -> None:
         fd = getattr(self, 'terminal_ready_fd', -1)
